# Template for sensitive credentials
# Apply directly using:
# kubectl create secret generic finlytics-secrets \
#   --namespace finlytics \
#   --from-literal=GEMINI_API_KEY="YOUR_ACTUAL_GEMINI_KEY"
#
# Or update the values below and apply: kubectl apply -f k8s/secrets.yaml
apiVersion: v1
kind: Secret
metadata:
  name: finlytics-secrets
  namespace: finlytics
type: Opaque
stringData:
  GEMINI_API_KEY: "your_gemini_api_key_here"
  # DATABASE_URL: "postgresql://username:password@rds-endpoint:5432/finlytics" # Optional if using AWS RDS

